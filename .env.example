# Frontend build-time variable. Set to the Render API URL including /api.
# Leave empty during local development to use the Vite /api proxy.
VITE_API_BASE_URL=

# Backend (Render) settings. Replace CORS_ORIGINS with the exact Vercel origin(s).
ENVIRONMENT=production
CORS_ORIGINS=https://your-farmintel-app.vercel.app
SQLITE_DB_PATH=/var/data/farmintel.db
CACHE_DIR_PATH=/var/data/cache

# Optional external data credentials. Keep values empty here and set real values
# only in the hosting provider's secret environment-variable settings.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
USDA_NASS_API_KEY=
